# ── Supabase ──────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API Keys (Project URL + anon/publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Dashboard → Project Settings → API Keys → service_role (server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# ── Database (Prisma) ────────────────────────────────────────────────────
# Dashboard → "Connect" button (top of any project page) → ORM tab → Prisma.
# Use the pooled ("Transaction") connection string for DATABASE_URL and the
# direct connection for DIRECT_URL (used by `prisma migrate`).
DATABASE_URL=
DIRECT_URL=

# ── AI Assistant provider ────────────────────────────────────────────────
# Swappable — see src/features/ai-assistant/lib/providers (AiProvider interface).
# "mock" (default) needs no key. "anthropic" calls Claude — set ANTHROPIC_API_KEY too.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
