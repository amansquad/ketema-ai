// Ketema AI — Prisma schema
// Auth users live in Supabase's `auth.users` table; `Profile.id` mirrors
// that user's UUID (no FK across schemas — Supabase manages `auth`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String    @id @db.Uuid // == auth.users.id
  email       String    @unique
  displayName String?
  locale      String    @default("en") // "en" | "am"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]

  @@map("profiles")
}

model Project {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  ownerId       String         @db.Uuid
  owner         Profile        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  scene         Json           @default("{}") // serialized SceneObject[] graph
  thumbnailUrl  String?
  isPublic      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  snapshots     SceneSnapshot[]
  shareLink     ShareLink?

  @@index([ownerId])
  @@map("projects")
}

// Point-in-time history for undo-across-sessions / autosave audit trail.
model SceneSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene     Json
  label     String? // e.g. "autosave", "manual", "before-ai-command"
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("scene_snapshots")
}

model ShareLink {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique @default(cuid())
  projectId String   @unique @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@map("share_links")
}
